# Copiez ce fichier en .env.local (développement) et renseignez les mêmes
# variables dans Vercel (Project Settings > Environment Variables) pour la prod.
#
# Ces valeurs viennent de votre projet Supabase : Project Settings > API.
# La clé anon est publique par design (protégée par les policies RLS de la
# table `inscriptions`, voir README.md) : elle peut être exposée côté client.

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-public
